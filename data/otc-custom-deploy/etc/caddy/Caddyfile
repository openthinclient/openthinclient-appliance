{
	local_certs
	skip_install_trust
}

:8080 {
	redir /ui/* https://{host}{uri} permanent
	reverse_proxy localhost:8081
}

http:// {
	redir /ui/* https://{host}{uri} permanent
	reverse_proxy localhost:8081
}

# Manager https
https:// {
    import ./ssl_config
	reverse_proxy localhost:8081
}

# Cert management
https://:8443 {
    import ./ssl_config
    reverse_proxy localhost:8082
}
