{
	local_certs
	skip_install_trust
    on_demand_tls {
        ask http://localhost:8082/is_domain_allowed
    }
}

:8080 {
	redir /ui/* https://{host}{uri} permanent
	reverse_proxy /download_cert localhost:8082
	reverse_proxy localhost:8081
}

http:// {
	redir /ui/* https://{host}{uri} permanent
	reverse_proxy localhost:8081
}

# Manager https
https:// {
    import ./ssl_config
	reverse_proxy localhost:8081
}

# Cert management
https://:8443 {
    import ./ssl_config
    reverse_proxy localhost:8082
}
