#!/bin/bash
set -euo pipefail

mkdir -p "$HOME/.pki/nssdb"
/usr/bin/certutil -N --empty-password -d "$HOME/.pki/nssdb"

certificate="$(find /etc/ssl/certs -name 'openthinclient_Management_Server*' | head -n 1)"

certutil -A \
    -i "$certificate" \
    -n "$(basename "$certificate")" \
    -t 'TCu,TCu,TCu' \
    -d "sql:$HOME/.pki/nssdb"
